{
  "organization": "ReefSoft LLC",
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "AWDLGuardKit",
    },
  ],
  "files": [
    { "path": "AWDLGuardKit" },
    {
      "kind": "folder",
      "path": "AWDLGuard",
      "target-membership": [
        "AWDLGuard",
      ],
    }, {
      "kind": "folder",
      "path": "AWDLGuardHelper",
      "target-membership": [
        "AWDLGuardHelper",
      ],
      "membership-exceptions": [
        {
          "target": "AWDLGuardHelper",
          "exclusions": [
            "Helper.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/AWDL Guard.app", "id": "AA0000000000000000000004", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AWDLGuardHelper", "id": "AA0000000000000000000005", "type": "compiled.mach-o.executable", "index": false, "target-membership": [ { "build-phase": "AWDLGuard/copy/Copy Helper", "code-sign-on-copy": true } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "AWDLGuard",
      "id": "AA0000000000000000000009",
      "product": "Products/AWDL Guard.app",
      "product-type": "application",
      "dependencies": [
        "AWDLGuardHelper",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Write Helper Plist",
          "input-paths": [
            "$(SRCROOT)/AWDLGuardHelper/Helper.plist",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(CONTENTS_FOLDER_PATH)/Library/LaunchDaemons/$(APP_BUNDLE_IDENTIFIER).Helper.plist",
          ],
          "shell": "/bin/sh",
          "script": "# The helper's launchd plist, named and labelled from APP_BUNDLE_IDENTIFIER (see the template).\nset -eu\nhelper=\"$APP_BUNDLE_IDENTIFIER.Helper\"\nplist=\"$SCRIPT_OUTPUT_FILE_0\"\nmkdir -p \"$(dirname \"$plist\")\"\ncp \"$SCRIPT_INPUT_FILE_0\" \"$plist\"\nplutil -insert Label -string \"$helper\" \"$plist\"\nplutil -insert MachServices -json \"{\\\"$helper\\\": true}\" \"$plist\"\nplutil -insert AssociatedBundleIdentifiers -json \"[\\\"$APP_BUNDLE_IDENTIFIER\\\"]\" \"$plist\"\nplutil -convert xml1 \"$plist\"\n",
        }, {
          "kind": "copy",
          "name": "Copy Helper",
          "bundle-base-path": "executables-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "GuardPolicy",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "HelperInterface",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AWDL Guard",
        "ENABLE_APP_SANDBOX": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName[config=Debug]": "AWDL Guard Debug",
        "INFOPLIST_KEY_CFBundleDisplayName[config=Release]": "AWDL Guard",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2026 ReefSoft LLC",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(APP_BUNDLE_IDENTIFIER)",
        "PRODUCT_NAME": "AWDL Guard",
      },
    }, {
      "name": "AWDLGuardHelper",
      "id": "AA0000000000000000000010",
      "product": "Products/AWDLGuardHelper",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "HelperInterface",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CREATE_INFOPLIST_SECTION_IN_BINARY": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(APP_BUNDLE_IDENTIFIER).Helper",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "APP_BUNDLE_IDENTIFIER[config=Debug]": "io.reefsoft.AWDLGuard.debug",
    "APP_BUNDLE_IDENTIFIER[config=Release]": "io.reefsoft.AWDLGuard",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "1",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "RJ67Z9VP9T",
    "ENABLE_HARDENED_RUNTIME": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "26.0",
    "MARKETING_VERSION": "0.1.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
