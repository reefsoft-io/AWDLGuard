{
  "default-configuration": "Release",
  "organization": "ReefSoft LLC",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "AWDLGuardKit",
    },
  ],
  "files": [
    { "path": "AWDLGuardKit" },
    { "kind": "folder", "path": "AWDLGuard", "target-membership": [ "AWDLGuard" ] },
    {
      "kind": "folder",
      "path": "AWDLGuardHelper",
      "target-membership": [
        "AWDLGuardHelper",
      ],
      "membership-exceptions": [
        {
          "build-phase": "AWDLGuard/copy/Copy Helper Plist",
          "inclusions": [
            "io.reefsoft.AWDLGuard.Helper.plist",
          ],
          "attributes": {
            "io.reefsoft.AWDLGuard.Helper.plist": { "code-sign-on-copy": true },
          },
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/AWDL Guard.app", "id": "AA0000000000000000000004", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AWDLGuardHelper", "id": "AA0000000000000000000005", "type": "compiled.mach-o.executable", "index": false, "target-membership": [ { "build-phase": "AWDLGuard/copy/Copy Helper", "code-sign-on-copy": true } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "AWDLGuard",
      "id": "AA0000000000000000000009",
      "product": "Products/AWDL Guard.app",
      "product-type": "application",
      "dependencies": [
        "AWDLGuardHelper",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Copy Helper Plist",
          "bundle-base-path": "root",
          "relative-path": "Contents/Library/LaunchDaemons",
        }, {
          "kind": "copy",
          "name": "Copy Helper",
          "bundle-base-path": "executables-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "GuardPolicy",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "HelperInterface",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AWDL Guard",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "AWDL Guard",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2026 ReefSoft LLC",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "0.1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "io.reefsoft.AWDLGuard",
        "PRODUCT_NAME": "AWDL Guard",
      },
    }, {
      "name": "AWDLGuardHelper",
      "id": "AA0000000000000000000010",
      "product": "Products/AWDLGuardHelper",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "HelperInterface",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CREATE_INFOPLIST_SECTION_IN_BINARY": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "io.reefsoft.AWDLGuard.Helper",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "RJ67Z9VP9T",
    "ENABLE_HARDENED_RUNTIME": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "26.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
