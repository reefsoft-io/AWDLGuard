<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The label, the Mach service and the file name must all equal the helper's bundle
     identifier: the app and helper derive the service name from it (HelperIdentity). -->
<plist version="1.0">
<dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>io.reefsoft.AWDLGuard</string>
	</array>
	<key>BundleProgram</key>
	<string>Contents/MacOS/AWDLGuardHelper</string>
	<key>Label</key>
	<string>io.reefsoft.AWDLGuard.Helper</string>
	<key>MachServices</key>
	<dict>
		<key>io.reefsoft.AWDLGuard.Helper</key>
		<true/>
	</dict>
</dict>
</plist>
